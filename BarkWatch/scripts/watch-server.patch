diff --git a/apns/watch_delete_test.go b/apns/watch_delete_test.go
new file mode 100644
index 0000000..32dc2bf
--- /dev/null
+++ b/apns/watch_delete_test.go
@@ -0,0 +1,58 @@
+package apns
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/sideshow/apns2"
+)
+
+func TestWatchDeletionPush(t *testing.T) {
+	var headers http.Header
+	var body map[string]interface{}
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		headers = r.Header.Clone()
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Error(err)
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+	originalClients := clients
+	clients = make(chan *apns2.Client, 1)
+	clients <- &apns2.Client{Host: server.URL, HTTPClient: server.Client()}
+	defer func() { clients = originalClients }()
+
+	for _, test := range []struct {
+		name, pushType, priority string
+		deletion                 bool
+	}{
+		{"delete", "background", "5", true},
+		{"alert", "alert", "10", false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			params := map[string]interface{}{"id": "watch-delete-test"}
+			if test.deletion {
+				params["delete"] = "1"
+			}
+			code, err := Push(&PushMessage{Id: "watch-delete-test", DeviceToken: "synthetic", Title: "Test", Body: "Body", Sound: "default", ExtParams: params})
+			if err != nil || code != http.StatusOK {
+				t.Fatalf("Push: code=%d, error=%v", code, err)
+			}
+			if headers.Get("apns-push-type") != test.pushType || headers.Get("apns-priority") != test.priority || headers.Get("apns-collapse-id") != "watch-delete-test" {
+				t.Fatalf("Unexpected push headers: %v", headers)
+			}
+			aps := body["aps"].(map[string]interface{})
+			if test.deletion {
+				if aps["content-available"] != float64(1) || aps["alert"] != nil || aps["sound"] != nil || body["delete"] != "1" || body["id"] != "watch-delete-test" {
+					t.Fatalf("Unexpected deletion payload: %v", body)
+				}
+			} else if aps["alert"] == nil || aps["content-available"] != nil {
+				t.Fatalf("Unexpected alert payload: %v", body)
+			}
+			body = nil
+		})
+	}
+}
